+
+
+def test_generation_remap_config(tmp_path: Path) -> None:
+    root = tmp_path / "out"
+    root.mkdir()
+    external = tmp_path / "external-tree"
+    external.mkdir()
+
+    config = dataclasses.replace(
+        Config.default(),
+        image="main",
+        output="main",
+        output_dir=root,
+        output_format=OutputFormat.directory,
+        base_trees=[root / "base"],
