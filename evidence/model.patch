+
+def test_generation_duplicate_output_dies(tmp_path: Path) -> None:
+    root = tmp_path / "out"
+    root.mkdir()
+    specs = [
+        make_spec(make_config("a", root, output="shared")),
+        make_spec(make_config("b", root, output="shared")),
+    ]
+    with pytest.raises(SystemExit):
