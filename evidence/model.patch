+        gen.close()
+
+    gen = Generation.begin(root, specs)
+    try:
+        gen.freeze_inputs({"meta": "2"})
+        assert gen.nodes["base"].status == NODE_PENDING
+        assert gen.needs_build("base")
+        assert not (gen.view / "base").exists()
+    finally:
+        gen.close()
